#!/usr/bin/env bash
set -Eeuo pipefail

exec > >(tee -a /var/log/agri-cycle-website-startup.log | logger -t agri-cycle-website-startup -s 2>/dev/console) 2>&1

readonly APP_ROOT="/srv/agri-cycle-website"
readonly APP_USER="agri-cycle"
readonly APP_REPO="${app_repo}"
readonly APP_BRANCH="${app_branch}"
readonly PUBLIC_HOSTNAME="${hostname}"
readonly LETSENCRYPT_EMAIL="${letsencrypt_email}"
readonly RELEASE_DIR="$APP_ROOT/releases/$APP_BRANCH"

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates certbot curl git nginx libnginx-mod-http-brotli-filter \
  libnginx-mod-http-brotli-static python3-certbot-nginx || \
  apt-get install -y ca-certificates certbot curl git nginx python3-certbot-nginx

if ! command -v node >/dev/null 2>&1 || [ "$(node -p 'Number(process.versions.node.split(".")[0])')" -lt 20 ]; then
  curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource_setup.sh
  bash /tmp/nodesource_setup.sh
  apt-get install -y nodejs
fi

if ! id "$APP_USER" >/dev/null 2>&1; then
  useradd --system --home-dir "$APP_ROOT" --shell /usr/sbin/nologin "$APP_USER"
fi

install -d -o "$APP_USER" -g "$APP_USER" "$APP_ROOT" "$APP_ROOT/releases"

if [ ! -d "$RELEASE_DIR/.git" ]; then
  git clone --depth 1 --branch "$APP_BRANCH" "$APP_REPO" "$RELEASE_DIR"
fi

cd "$RELEASE_DIR"
npm ci

# `NEXT_PUBLIC_*` values are inlined at build time, not read at runtime, so this
# has to be exported before the build rather than set on the service. It is what
# decides whether the host invites crawlers: anything other than the production
# domain emits `noindex` and a blanket `Disallow: /`, which is what keeps a
# staging copy from competing with production in search.
export NEXT_PUBLIC_SITE_URL="https://$PUBLIC_HOSTNAME"
npm run build

ln -sfn "$RELEASE_DIR" "$APP_ROOT/current"
chown -R "$APP_USER:$APP_USER" "$APP_ROOT"

cat >/etc/systemd/system/agri-cycle-website.service <<'UNIT'
[Unit]
Description=Agri-Cycle Website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agri-cycle
Group=agri-cycle
WorkingDirectory=/srv/agri-cycle-website/current
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /srv/agri-cycle-website/current/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

cat >/etc/nginx/sites-available/agri-cycle-website <<NGINX
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name $PUBLIC_HOSTNAME _;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
NGINX

# Compress the text payloads Next serves. HTML, JS, CSS and JSON are the bulk of
# a page load and none of them are compressed by default on Ubuntu's nginx.
cat >/etc/nginx/conf.d/agri-cycle-compression.conf <<'NGINX'
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types
    application/javascript
    application/json
    application/manifest+json
    application/rss+xml
    application/xml
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;
NGINX

# Brotli beats gzip by roughly 15-20% on JS and CSS. The module is optional on
# Ubuntu, so only write the config when nginx actually has it loaded — an
# unknown directive is a hard config error and would take the whole site down.
if nginx -V 2>&1 | grep -q brotli || [ -f /usr/share/nginx/modules-available/mod-http-brotli-filter.conf ]; then
  cat >/etc/nginx/conf.d/agri-cycle-brotli.conf <<'NGINX'
brotli on;
brotli_comp_level 5;
brotli_min_length 1024;
brotli_types
    application/javascript
    application/json
    application/manifest+json
    application/rss+xml
    application/xml
    image/svg+xml
    text/css
    text/javascript
    text/plain
    text/xml;
NGINX
  if ! nginx -t; then
    echo "brotli config rejected by nginx; removing it and continuing with gzip only" >&2
    rm -f /etc/nginx/conf.d/agri-cycle-brotli.conf
  fi
fi

if [ -e /etc/nginx/sites-enabled/default ]; then
  mv /etc/nginx/sites-enabled/default /etc/nginx/sites-available/default.disabled
fi

if [ ! -e /etc/nginx/sites-enabled/agri-cycle-website ]; then
  ln -s /etc/nginx/sites-available/agri-cycle-website /etc/nginx/sites-enabled/agri-cycle-website
fi

systemctl daemon-reload
systemctl enable --now agri-cycle-website
nginx -t
systemctl enable --now nginx
systemctl reload nginx

tls_ready=false
for attempt in $(seq 1 20); do
  if certbot certificates 2>/dev/null | grep -q "Domains:.*$PUBLIC_HOSTNAME"; then
    tls_ready=true
    break
  fi

  if [ -n "$LETSENCRYPT_EMAIL" ]; then
    certbot_args=(--email "$LETSENCRYPT_EMAIL")
  else
    certbot_args=(--register-unsafely-without-email)
  fi

  if certbot --nginx --non-interactive --agree-tos "$${certbot_args[@]}" --redirect -d "$PUBLIC_HOSTNAME"; then
    tls_ready=true
    break
  fi

  sleep 30
done

if [ "$tls_ready" != true ]; then
  echo "Let's Encrypt certificate setup did not complete for $PUBLIC_HOSTNAME" >&2
  exit 1
fi

# Certbot writes a plain `listen 443 ssl;` block, which leaves the site on
# HTTP/1.1 — every request to this origin then pays a fresh round trip instead
# of multiplexing over one connection, and it shows up as slow on mobile.
# nginx moved the directive in 1.25.1: older builds take it as a `listen`
# parameter, newer ones want the standalone `http2 on;` and warn about the old
# form. Pick the right one for whatever version the image shipped with.
nginx_version="$(nginx -v 2>&1 | sed -n 's#.*nginx/\([0-9.]*\).*#\1#p')"
nginx_major="$${nginx_version%%.*}"
nginx_minor="$(echo "$nginx_version" | cut -d. -f2)"

if [ "$nginx_major" -gt 1 ] || { [ "$nginx_major" -eq 1 ] && [ "$nginx_minor" -ge 25 ]; }; then
  if ! grep -q '^\s*http2 on;' /etc/nginx/sites-available/agri-cycle-website; then
    sed -i '0,/listen 443 ssl/s//http2 on;\n    listen 443 ssl/' \
      /etc/nginx/sites-available/agri-cycle-website
  fi
else
  sed -i -E 's/listen (\[::\]:)?443 ssl;/listen \1443 ssl http2;/' \
    /etc/nginx/sites-available/agri-cycle-website
fi

if ! nginx -t; then
  echo "HTTP/2 nginx edit did not validate; leaving the certbot config as-is" >&2
  sed -i -E 's/listen (\[::\]:)?443 ssl http2;/listen \1443 ssl;/' \
    /etc/nginx/sites-available/agri-cycle-website
  sed -i '/^\s*http2 on;$/d' /etc/nginx/sites-available/agri-cycle-website
fi

nginx -t
systemctl reload nginx

# Fail loudly if the origin is still HTTP/1.1 — this is the thing being fixed.
if command -v curl >/dev/null 2>&1; then
  # The percent-brace below is doubled on purpose. Terraform reads a single
  # percent-brace as the start of a template directive and rejects the whole
  # file; doubling it emits one, which is what curl wants for its write-out
  # format. Same reason the certbot array above is written with two dollars.
  negotiated="$(curl -sS -o /dev/null -w '%%{http_version}' "https://$PUBLIC_HOSTNAME/" || echo "unknown")"
  echo "Negotiated HTTP version for https://$PUBLIC_HOSTNAME/: $negotiated"
fi

for attempt in $(seq 1 30); do
  if curl --fail --silent --show-error http://127.0.0.1:3000/ >/dev/null; then
    exit 0
  fi
  sleep 2
done

echo "The website did not become healthy at http://127.0.0.1:3000/" >&2
exit 1
